def decode_make(val):
    # Map a MAKE code to a human-readable brand name.
    # try both int and str versions to be safe
    if val in make_label_map:
        return make_label_map[val]
    try:
        return make_label_map[int(val)]
    except Exception:
        return str(val)

# Helper: build dropdown with (nice_label, raw_code) options
def coded_dropdown(df, col, label_map, description):
    vals = df[col].dropna().unique()
    try:
        vals = sorted(vals)
    except TypeError:
        vals = sorted(vals, key=lambda x: str(x))
    options = []
    for v in vals:
        label = label_map.get(v, label_map.get(str(v), str(v)))
        options.append((label, v))  # (what user sees, actual value)
    return widgets.Dropdown(
        options=options,
        description=description,
        style={'description_width': 'initial'}
    )

