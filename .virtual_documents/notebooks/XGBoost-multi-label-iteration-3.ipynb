## Create a GUI for the recommendation function

import numpy as np
import pandas as pd
import ipywidgets as widgets
from IPython.display import display, clear_output

# ---------- 1. Helper: recommendation function ----------

def recommend_makes(user_features, pipe, mlb, top_k=5):
    """
    user_features: dict with keys matching feature_cols
    pipe: trained sklearn Pipeline (preprocess + OneVsRest(XGB/RF))
    mlb: fitted MultiLabelBinarizer
    top_k: how many makes to return
    """
    X_new = pd.DataFrame([user_features])
    
    preprocess = pipe.named_steps["preprocess"]
    clf = pipe.named_steps["clf"]
    
    X_new_trans = preprocess.transform(X_new)
    
    # P(has this make) for each class
    probs = np.column_stack([
        est.predict_proba(X_new_trans)[:, 1]
        for est in clf.estimators_
    ])[0]  # shape: (n_classes,)
    
    top_k = min(top_k, len(mlb.classes_))
    top_idx = np.argsort(probs)[::-1][:top_k]
    
    top_makes = mlb.classes_[top_idx]
    top_probs = probs[top_idx]
    
    return list(zip(top_makes, top_probs))


