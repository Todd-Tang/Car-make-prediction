## Get important features from XGB model
import numpy as np
import pandas as pd

# 1. Get feature names after preprocessing
preprocess = pipe.named_steps["preprocess"]
feature_names = preprocess.get_feature_names_out()
print("Number of transformed features:", len(feature_names))


# 2. Get estimators from OneVsRestClassifier
estimators = pipe.named_steps["clf"].estimators_

# 3. Stack feature_importances_ from each XGB model
all_importances = np.vstack([
    est.feature_importances_ for est in estimators
])  # shape: (n_classes, n_features)

print("Importances shape:", all_importances.shape)

# 4. Average importance across all classes (makes)
mean_importance = all_importances.mean(axis=0)  # shape: (n_features,)
print("Mean importance length:", len(mean_importance))
print("Feature names length:", len(feature_names))


# 5. Build DataFrame
importance_df = pd.DataFrame({
    "feature": feature_names,
    "importance": mean_importance
}).sort_values("importance", ascending=False)

importance_df.head(15)



