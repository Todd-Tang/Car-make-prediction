        for k, v in user_features.items():
            label_map = feature_label_maps.get(k)
            if label_map is not None:
                # Try int and str keys
                human = label_map.get(v, label_map.get(str(v), v))
            else:
                human = v
            print(f"  {k}: {human} (code={v})")
        
        # ---- Pretty-print recommended makes using brand names ----
        print(f"\nRecommended makes (Top-{top_k}):")
        for make_code, p in recs:
            make_name = decode_make(make_code)
            print(f"  {make_name:<20} (code={make_code})   prob ≈ {p:.3f}")

