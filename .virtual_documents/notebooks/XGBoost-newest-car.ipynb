from sklearn.preprocessing import LabelEncoder

X = df_primary[feature_cols].copy()
y_raw = df_primary["MAKE"].copy()

le = LabelEncoder()
y = le.fit_transform(y_raw)   # now y is 0,1,2,...,K-1

print("Original classes:", le.classes_)   # e.g. [ 2  6  7 12 ... 98]
print("Encoded classes:", np.unique(y))   # e.g. [0 1 2 ... 21]


X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.2,
    stratify=y,
    random_state=42
)


numeric_features = ["HHSIZE", "HHFAMINC", "WRKCOUNT", "DRVRCNT"]
categorical_features = ["LIF_CYC", "CENSUS_R", "HH_RACE", "HOMEOWN", "URBAN", "URBANSIZE"]

preprocess = ColumnTransformer(
    transformers=[
        ("num", StandardScaler(), numeric_features),
        ("cat", OneHotEncoder(handle_unknown="ignore"), categorical_features),
    ]
)


dummy = Pipeline([
    ("preprocess", preprocess),
    ("clf", DummyClassifier(strategy="most_frequent"))
])

# Fit baseline
dummy.fit(X_train, y_train)

y_dummy_pred = dummy.predict(X_test)
dummy_acc = accuracy_score(y_test, y_dummy_pred)
print("Baseline (most frequent make) accuracy:", dummy_acc)


xgb_clf = xgb.XGBClassifier(
    n_estimators=300,
    max_depth=5,
    learning_rate=0.1,
    subsample=0.8,
    colsample_bytree=0.8,
    objective="multi:softprob",   # multiclass probabilities
    eval_metric="mlogloss",
    tree_method="hist",
    n_jobs=-1,
    random_state=42
)

pipe = Pipeline([
    ("preprocess", preprocess),
    ("xgb", xgb_clf)
])


cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

cv_scores = cross_val_score(
    pipe,
    X, y,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

print("XGBoost CV Accuracy:", cv_scores.mean(), "+/-", cv_scores.std())


pipe.fit(X_train, y_train)


# Access fitted classifier and transformed test data
clf_step = pipe.named_steps["clf"]
X_test_trans = pipe.named_steps["preprocess"].transform(X_test)

# Get probability that each household has each make
probs_per_class = np.column_stack([
    est.predict_proba(X_test_trans)[:, 1]   # P(has this make)
    for est in clf_step.estimators_
])

probs_per_class.shape  # (n_samples, n_classes)


